<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Required under the hardened runtime so the Core Audio process tap can
	     read app audio. Pairs with NSAudioCaptureUsageDescription in Info.plist;
	     without it a notarized (hardened-runtime) build is denied audio access. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
